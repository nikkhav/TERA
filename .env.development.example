APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///.local/tera.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.local/documents

AUTH_SECRET_KEY=local-development-secret-with-at-least-32-bytes
AUTH_TOKEN_MINUTES=480
AUTH_ALLOW_REGISTRATION=true

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_THINK=false
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=2048
RECEIPT_RECHECK_ENABLED=true
MODEL_TIMEOUT_SECONDS=300
JOB_LEASE_SECONDS=1200
