POSTGRES_PORT=5433
POSTGRES_PASSWORD=tera-local
DATABASE_URL=postgresql+psycopg://tera:tera-local@localhost:5433/tera
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=tera-local
S3_SECRET_KEY=tera-local-secret
S3_BUCKET=tera-documents
S3_REGION=us-east-1

# The application uses one model. Change it here.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
OLLAMA_IMAGE=ollama/ollama:latest
# Optional request setting; remove it for models that do not support this option.
OLLAMA_THINK=false
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=1536
MODEL_TIMEOUT_SECONDS=300
JOB_LEASE_SECONDS=1200
